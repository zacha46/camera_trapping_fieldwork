# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron
.env

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# compiled code 
src/*.o
src/*.so
src/*.dll

# macOS
.DS_Store

# Claude Code: local notes and per-machine settings stay off GitHub
.claude/prompts_and_responses/
.claude/settings.local.json

# Campaign raw inputs: large (netCDF, PDF basemaps) or not ours to redistribute
# (Google satellite screenshots). Only a README describing them is tracked.
campaigns/*/data/raw/*
!campaigns/*/data/raw/README.md

# Large rasters and netCDF anywhere in the repo
*.nc
*.tif
*.tiff

# Campaign outputs that carry camera coordinates or third-party imagery.
# This is a public repo, so planned and deployed camera locations never go up.
# Wind roses and summary tables (no coordinates) are tracked.
campaigns/*/outputs/*.gpkg
campaigns/*/outputs/*.kml
campaigns/*/outputs/*points*.csv
campaigns/*/outputs/*preview*.png
campaigns/*/data/processed/*.gpkg
# QField project folders: GeoPackage with camera points, basemap and .qgs
campaigns/*/outputs/qfield_*/
